{
  // Type-checks the sources together with the tests, which `tsconfig.json`
  // deliberately excludes because it emits `lib/`. The test runner strips types
  // without checking them, so this project is the only thing that does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
