# The `@deepseek-ai/*` peers are pinned to the harness release line this plugin
# targets, so a plain `npm install` resolves a consistent graph. These two keys are
# pnpm-only and stop pnpm from vendoring its own copies of the peers; npm ignores
# them and prints a cosmetic "Unknown project config" warning.
auto-install-peers=false
link-workspace-packages=false
